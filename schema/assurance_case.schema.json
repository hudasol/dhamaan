          "description": "Assumption ids.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claim_about": {
          "description": "What the claim is about.",
          "enum": [
            "hardware",
            "software",
            "process",
            "argument"
          ],
          "type": "string"
        },
        "context": {
          "description": "Context ids.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "description": "Evidence item ids.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "Unique id.",
          "pattern": "^G\\d+$",
          "type": "string"
        },
        "supported_by": {
          "description": "Child goals or strategies.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "Statement in plain words.",
          "type": "string"
        },
        "undeveloped": {
          "description": "True when the goal is deliberately not developed.",
          "type": "boolean"
        },
        "undeveloped_reason": {
          "description": "Why the goal is undeveloped.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "claim_about"
      ],
      "type": "object"
    },
    "strategies": {
