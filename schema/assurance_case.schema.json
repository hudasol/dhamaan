          "description": "Unique id.",
          "pattern": "^C\\d+$",
          "type": "string"
        },
        "text": {
          "description": "Statement in plain words.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "description": "Evidence items (solutions).",
      "properties": {
