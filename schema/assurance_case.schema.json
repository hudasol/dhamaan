          "description": "Path of the artefact, relative to the repository root; required unless open.",
          "type": "string"
        },
        "credibility_context": {
          "description": "Context ids that state the context of use of this evidence (credit condition 1).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "credibility_physical_data": {
          "description": "Repository path of measured data the evidence was compared with (credit condition 2).",
          "type": "string"
        },
        "credibility_uncertainty": {
          "description": "Repository path of the uncertainty or sensitivity result for this evidence (credit condition 3).",
          "type": "string"
        },
        "credibility_verifier_record": {
          "description": "Repository path of the record of a verifier who is not the developer (credit condition 4).",
          "type": "string"
        },
        "decision_needed": {
          "description": "A decision by the owner is needed first.",
          "type": "boolean"
        },
        "id": {
          "description": "Unique id.",
          "pattern": "^EV-\\d{2}$",
          "type": "string"
        },
        "kind": {
          "description": "How the evidence was produced; required unless open.",
          "enum": [
            "simulated",
            "bench",
            "field"
          ],
          "type": "string"
        },
        "note": {
          "description": "Free note.",
          "type": "string"
        },
        "optional": {
          "description": "Item is optional for this case.",
          "type": "boolean"
        },
        "rows": {
          "description": "Evidence table rows that motivate the item.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sha256": {
          "description": "SHA-256 of the artefact file; required unless open.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "description": "open, partial or provided.",
          "enum": [
            "open",
            "partial",
            "provided"
          ],
          "type": "string"
        },
        "title": {
          "description": "What the evidence is.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "rows"
      ],
      "type": "object"
    },
    "goals": {
      "additionalProperties": false,
      "description": "Claims.",
