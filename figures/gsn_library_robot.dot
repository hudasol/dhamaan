digraph GSN {
  rankdir=TB; nodesep=0.25; ranksep=0.55; bgcolor="white";
  node [fontname="Helvetica", fontsize=10, style="filled", color="#c2547a", fontcolor="#4a2433", margin="0.10,0.06"];
  edge [color="#c2547a"];
  label="Illustrative skeleton. Dashed evidence is open. Partial: EV-08 (simulated), EV-12 (simulated). Simulated evidence supports no hardware claim."; labelloc=t; fontname="Helvetica"; fontsize=11;
  G1 [shape=box, style="filled", fillcolor="#fde8ef", label="G1\nThe library service robot is\nacceptably safe to operate in the\ndefined library ODD."];
  G2 [shape=box, style="filled", fillcolor="#fde8ef", label="G2\nCollision and contact harm to\npeople is controlled."];
  G3 [shape=box, style="filled", fillcolor="#fde8ef", label="G3\nLearning based perception is\nadequate within the ODD."];
  G4 [shape=box, style="filled", fillcolor="#fde8ef", label="G4\nNavigation and planning failures\nend in a safe state or minimum\nrisk behaviour."];
  G5 [shape=box, style="filled", fillcolor="#fde8ef", label="G5\nPeople, including vulnerable\nusers, can predict, oversee and\nstop the robot."];
  G6 [shape=box, style="filled", fillcolor="#fde8ef", label="G6\nBuilding conditions (temperature,\ndust, glare) do not invalidate the\nevidence."];
  G7 [shape=box, style="filled", fillcolor="#fde8ef", label="G7\nSoftware updates and cyber events\ndo not undermine the safety\nclaims."];
  G8 [shape=box, style="filled", fillcolor="#fde8ef", label="G8\nField operation is monitored, and\nincidents are reported and learned\nfrom."];
  G9 [shape=box, style="filled,dashed", fillcolor="#fde8ef", label="G9\nManipulator hazards are\ncontrolled, if an arm is fitted."];
  U_G9 [shape=diamond, style="filled,dashed", fillcolor="white", label="Undeveloped"]; G9 -> U_G9;
  G10 [shape=box, style="filled", fillcolor="#fde8ef", label="G10\nThe argument itself is sound, with\nreview, defeaters considered and\nconfidence stated."];
  S1 [shape=parallelogram, fillcolor="#f9d5e2", label="S1\nArgue over hazard classes\ntaken from the risk\nassessment."];
  C1 [shape=box, style="rounded,filled,dashed", fillcolor="#fff6f9", label="C1\nOperational design domain (ODD)\nof the library. Layout,\noccupancy range, floors,\nlighting, network and\nlocalisation sources, and what\nis out of scope are to be\ndefined."];
  C2 [shape=box, style="rounded,filled,dashed", fillcolor="#fff6f9", label="C2\nSystem definition and user\nclasses (children, elderly\npeople, people with\ndisabilities, staff)."];
  C3 [shape=box, style="rounded,filled,dashed", fillcolor="#fff6f9", label="C3\nApplicable regime for this\ndeployment (UAE federal,\nemirate, host organisation\npolicy, insurer). Not yet\ndetermined."];
  AS1 [shape=ellipse, style="filled", fillcolor="#fff6f9", label="AS1 (assumption)\nThe scenario (a mobile service\nrobot with learning based\nperception that fetches and\nreturns books and guides\nvisitors in a library in the\nUAE) is assumed for\nillustration."];
  AS2 [shape=ellipse, style="filled", fillcolor="#fff6f9", label="AS2 (assumption)\nAn arm is optional. If no arm is\nfitted, goal G9 is removed."];
  AS3 [shape=ellipse, style="filled", fillcolor="#fff6f9", label="AS3 (assumption)\nThe library is an indoor, air\nconditioned space with daylight\nthrough glazing. This is our\naddition and has not been\nchecked against any real\nbuilding."];
  AS4 [shape=ellipse, style="filled", fillcolor="#fff6f9", label="AS4 (assumption)\nNo UAE rule specific to indoor\nground service robots was found\nin the sources retrieved. This\nis a statement about the search,\nnot about the law."];
  G1 -> S1;
  G1 -> G10;
  G1 -> C1 [arrowhead=empty, style=dashed];
  G1 -> C2 [arrowhead=empty, style=dashed];
  G1 -> C3 [arrowhead=empty, style=dashed];
  G1 -> AS1 [arrowhead=empty, style=dotted];
  G2 -> C1 [arrowhead=empty, style=dashed];
  G3 -> C1 [arrowhead=empty, style=dashed];
  G4 -> C1 [arrowhead=empty, style=dashed];
  G5 -> C2 [arrowhead=empty, style=dashed];
  G6 -> C1 [arrowhead=empty, style=dashed];
  G6 -> AS3 [arrowhead=empty, style=dotted];
  G7 -> C1 [arrowhead=empty, style=dashed];
  G8 -> C3 [arrowhead=empty, style=dashed];
  G9 -> C1 [arrowhead=empty, style=dashed];
  G9 -> AS2 [arrowhead=empty, style=dotted];
  S1 -> G2;
  S1 -> G3;
  S1 -> G4;
  S1 -> G5;
  S1 -> G6;
  S1 -> G7;
  S1 -> G8;
  S1 -> G9;
  S1 -> SN_EV02 [style=dashed];
  SN_EV02 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-02\nopen"];
  SN_EV04 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-04\nopen"];
  SN_EV05 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-05\nopen"];
  SN_EV06 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-06\nopen"];
  SN_EV07 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-07\nopen"];
  SN_EV08 [shape=circle, style="filled", fixedsize=true, width=0.8, fontsize=9, fillcolor="#fbe3ec", label="EV-08\npartial\nsimulated"];
  SN_EV09 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-09\nopen"];
  SN_EV10 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-10\nopen"];
  SN_EV11 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-11\nopen"];
  SN_EV12 [shape=circle, style="filled", fixedsize=true, width=0.8, fontsize=9, fillcolor="#fbe3ec", label="EV-12\npartial\nsimulated"];
  SN_EV13 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-13\nopen"];
  SN_EV14 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-14\nopen"];
  SN_EV15 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-15\nopen"];
  SN_EV16 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-16\nopen"];
  SN_EV17 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-17\nopen"];
  SN_EV18 [shape=circle, style="filled,dashed", fixedsize=true, width=0.8, fontsize=9, fillcolor="#ffffff", label="EV-18\nopen"];
  G2 -> SN_EV04 [style=dashed];
  G2 -> SN_EV05 [style=dashed];
  G2 -> SN_EV06 [style=dashed];
  G3 -> SN_EV07 [style=dashed];
  G3 -> SN_EV09 [style=dashed];
